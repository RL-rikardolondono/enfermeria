generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  paciente
  profesional
  admin
}

enum EstadoUsuario {
  activo
  suspendido
  pendiente_verificacion
}

enum EstadoServicio {
  pendiente
  asignado
  en_camino
  en_curso
  completado
  cancelado
}

enum TipoServicio {
  curacion
  medicacion
  inyeccion
  control
  cuidado_basico
  urgencia
}

enum EstadoVerificacion {
  pendiente
  aprobado
  rechazado
}

enum EstadoPago {
  pendiente
  aprobado
  fallido
  reembolsado
}

model Usuario {
  id             String        @id @default(uuid())
  rol            RolUsuario    @default(paciente)
  nombreCompleto String        @map("nombre_completo") @db.VarChar(200)
  telefono       String?       @unique @db.VarChar(20)
  email          String        @unique @db.VarChar(150)
  passwordHash   String        @map("password_hash") @db.VarChar(255)
  estado         EstadoUsuario @default(activo)
  fotoUrl        String?       @map("foto_url") @db.VarChar(500)
  aceptoTerminosEn DateTime?   @map("acepto_terminos_en")
  claveCreada    Boolean       @default(true) @map("clave_creada")
  ultimoIngreso  DateTime?     @map("ultimo_ingreso")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  sesiones       Sesion[]
  pacientes      Paciente[]
  profesional    Profesional?
  notificaciones Notificacion[]
  recuperaciones RecuperacionClave[]
  @@map("usuarios")
}

model Sesion {
  id          String    @id @default(uuid())
  usuarioId   String    @map("usuario_id")
  tokenHash   String?   @map("token_hash") @db.VarChar(500)
  refreshHash String?   @map("refresh_hash") @db.VarChar(500)
  dispositivo String?   @db.VarChar(200)
  ip          String?   @db.VarChar(50)
  activa      Boolean   @default(true)
  expiresAt   DateTime? @map("expires_at")
  ultimoUso   DateTime  @default(now()) @map("ultimo_uso") // se cierra tras 15-20 min sin uso
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@index([usuarioId])
  @@map("sesiones")
}

model Paciente {
  id                         String    @id @default(uuid())
  usuarioId                  String    @map("usuario_id") // titular de la cuenta que gestiona a este paciente
  nombreCompleto             String?   @map("nombre_completo") @db.VarChar(200)
  parentesco                 String?   @db.VarChar(50)
  esTitular                  Boolean   @default(false) @map("es_titular")
  fechaNacimiento            DateTime? @map("fecha_nacimiento") @db.Date
  genero                     String?   @db.VarChar(20)
  tipoSangre                 String?   @map("tipo_sangre") @db.VarChar(5)
  alergias                   String?
  antecedentes               String?
  eps                        String?   @db.VarChar(100)
  regimen                    String?   @db.VarChar(50)
  documentoTipo              String?   @map("documento_tipo") @db.VarChar(50)
  documentoNumero            String?   @map("documento_numero") @db.VarChar(50)
  direccionBase              String?   @map("direccion_base") @db.VarChar(500)
  direccionPrincipal         String?   @map("direccion_principal") @db.VarChar(500)
  ciudad                     String?   @db.VarChar(100)
  barrio                     String?   @db.VarChar(100)
  estrato                    Int?
  latBase                    Decimal?  @map("lat_base") @db.Decimal(10, 8)
  lngBase                    Decimal?  @map("lng_base") @db.Decimal(11, 8)
  latitud                    Decimal?  @db.Decimal(10, 8)
  longitud                   Decimal?  @db.Decimal(11, 8)
  contactoEmergencia         String?   @map("contacto_emergencia") @db.VarChar(200)
  contactoEmergenciaNombre   String?   @map("contacto_emergencia_nombre") @db.VarChar(200)
  contactoEmergenciaTelefono String?   @map("contacto_emergencia_telefono") @db.VarChar(20)
  contactoEmergenciaRelacion String?   @map("contacto_emergencia_relacion") @db.VarChar(50)
  medicamentosActuales       String?   @map("medicamentos_actuales")
  condicionesCronicas        String?   @map("condiciones_cronicas")
  observaciones              String?
  numeroHistoria             String?   @map("numero_historia") @db.VarChar(100)
  peso                       Decimal?  @db.Decimal(5, 2)
  talla                      Decimal?  @db.Decimal(5, 2)
  imc                        Decimal?  @db.Decimal(5, 2)
  grupoEtnico                String?   @map("grupo_etnico") @db.VarChar(100)
  ocupacion                  String?   @db.VarChar(100)
  nivelEducativo             String?   @map("nivel_educativo") @db.VarChar(100)
  estadoCivil                String?   @map("estado_civil") @db.VarChar(50)
  nombreAcudiente            String?   @map("nombre_acudiente") @db.VarChar(200)
  telefonoAcudiente          String?   @map("telefono_acudiente") @db.VarChar(20)
  activo                     Boolean   @default(true)
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  usuario                    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  servicios                  Servicio[]
  @@index([usuarioId])
  @@map("pacientes")
}

model Profesional {
  id                   String             @id @default(uuid())
  usuarioId            String             @unique @map("usuario_id")
  especialidad         String?            @db.VarChar(100)
  registroProfesional  String?            @map("registro_profesional") @db.VarChar(100)
  estadoVerificacion   EstadoVerificacion @default(pendiente) @map("estado_verificacion")
  disponible           Boolean            @default(false)
  disponibleDesde      DateTime?          @map("disponible_desde") // inicio del turno (máximo 12 horas)
  ignoradas            Int                @default(0) // solicitudes seguidas que dejó pasar sin responder
  lat                  Decimal?           @db.Decimal(10, 8)
  lng                  Decimal?           @db.Decimal(11, 8)
  latBase              Decimal?           @map("lat_base") @db.Decimal(10, 8)
  lngBase              Decimal?           @map("lng_base") @db.Decimal(11, 8)
  radioAtencion        Decimal?           @map("radio_atencion") @db.Decimal(8, 2)
  calificacionPromedio Decimal?           @map("calificacion_promedio") @db.Decimal(3, 2)
  totalServicios       Int                @default(0) @map("total_servicios")
  tarifaHora           Decimal?           @map("tarifa_hora") @db.Decimal(12, 2)
  anosExperiencia      Int?               @map("anos_experiencia")
  hojaVidaUrl          String?            @map("hoja_vida_url") @db.VarChar(500)
  fotoUrl              String?            @map("foto_url") @db.VarChar(500)
  banco                String?            @db.VarChar(100)
  cuentaBancaria       String?            @map("cuenta_bancaria") @db.VarChar(100)
  tipoCuenta           String?            @map("tipo_cuenta") @db.VarChar(50)
  verificadoPor        String?            @map("verificado_por")
  verificadoEn         DateTime?          @map("verificado_en")
  activo               Boolean            @default(true)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  usuario              Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  documentos           DocumentoProfesional[]
  servicios            Servicio[]
  evoluciones          Evolucion[]
  tracking             TrackingHistorial[]
  ofertas              Oferta[]
  quejas               Queja[]
  bloqueos             Bloqueo[]
  @@map("profesionales")
}

model DocumentoProfesional {
  id            String      @id @default(uuid())
  profesionalId String      @map("profesional_id")
  tipo          String      @db.VarChar(100)
  url           String      @db.VarChar(500)
  createdAt     DateTime    @default(now()) @map("created_at")
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  @@map("documentos_profesional")
}

model Servicio {
  id                     String         @id @default(uuid())
  pacienteId             String?        @map("paciente_id")
  profesionalId          String?        @map("profesional_id")
  tipo                   TipoServicio
  estado                 EstadoServicio @default(pendiente)
  descripcion            String?
  direccion              String?        @db.VarChar(500)
  barrio                 String?        @db.VarChar(100)
  lat                    Decimal?       @db.Decimal(10, 8)
  lng                    Decimal?       @db.Decimal(11, 8)
  notas                  String?
  codigo                 String?        @db.VarChar(50)
  prioridad              String?        @default("normal") @db.VarChar(20)
  fechaSolicitud         DateTime       @default(now()) @map("fecha_solicitud")
  fechaInicio            DateTime?      @map("fecha_inicio")
  fechaFin               DateTime?      @map("fecha_fin")
  monto                  Decimal?       @db.Decimal(12, 2)
  calificacion           Int?
  comentarioCalificacion String?        @map("comentario_calificacion")
  calificadoEn           DateTime?      @map("calificado_en")
  resenaOculta           Boolean        @default(false) @map("resena_oculta") // la IPS puede ocultar un comentario inapropiado
  buscandoHasta          DateTime?      @map("buscando_hasta") // fin de la búsqueda de profesional (10 min) o del plazo de pago
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  paciente               Paciente?      @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  profesional            Profesional?   @relation(fields: [profesionalId], references: [id], onDelete: Restrict)
  evoluciones            Evolucion[]
  pago                   Pago?
  tracking               TrackingHistorial[]
  ofertas                Oferta[]
  quejas                 Queja[]
  recibido               Recibido?
  @@index([estado, createdAt])
  @@index([estado, buscandoHasta])
  @@index([profesionalId, calificacion])
  @@index([estado, fechaSolicitud])
  @@index([createdAt])
  @@index([pacienteId])
  @@index([profesionalId])
  @@map("servicios")
}

model Evolucion {
  id                 String       @id @default(uuid())
  servicioId         String       @map("servicio_id")
  profesionalId      String?      @map("profesional_id")
  tensionSistolica   Int?         @map("tension_sistolica")
  tensionDiastolica  Int?         @map("tension_diastolica")
  frecuenciaCardiaca Int?         @map("frecuencia_cardiaca")
  temperatura        Decimal?     @db.Decimal(4, 1)
  saturacionOxigeno  Int?         @map("saturacion_oxigeno")
  glucemia           Int?
  observaciones      String?
  procedimientos     String?
  impresionDiagnostica String?    @map("impresion_diagnostica")
  recomendaciones    String?
  createdAt          DateTime     @default(now()) @map("created_at")
  servicio           Servicio     @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  profesional        Profesional? @relation(fields: [profesionalId], references: [id], onDelete: Restrict)
  @@index([servicioId])
  @@map("evoluciones")
}

model Pago {
  id                String     @id @default(uuid())
  servicioId        String     @unique @map("servicio_id")
  monto             Decimal    @db.Decimal(12, 2)
  estado            EstadoPago @default(pendiente)
  referenciaExterna String?    @map("referencia_externa") @db.VarChar(200)
  // Pago retenido: retenido → liberado (con nota clínica) → transferido; o reembolso si se cancela
  estadoLiquidacion String     @default("retenido") @map("estado_liquidacion") @db.VarChar(20)
  comision          Int?
  valorProfesional  Int?       @map("valor_profesional")
  liberadoEn        DateTime?  @map("liberado_en")
  transferidoEn     DateTime?  @map("transferido_en")
  createdAt         DateTime   @default(now()) @map("created_at")
  servicio          Servicio   @relation(fields: [servicioId], references: [id])
  @@index([estadoLiquidacion, createdAt])
  @@index([estado, createdAt])
  @@map("pagos")
}

model Notificacion {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  tipo      String?  @db.VarChar(100)
  titulo    String?  @db.VarChar(200)
  cuerpo    String?
  leida     Boolean  @default(false)
  datos     Json?
  createdAt DateTime @default(now()) @map("created_at")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@index([usuarioId, tipo])
  @@map("notificaciones")
}

model TrackingHistorial {
  id            String      @id @default(uuid())
  servicioId    String      @map("servicio_id")
  profesionalId String      @map("profesional_id")
  lat           Decimal     @db.Decimal(10, 8)
  lng           Decimal     @db.Decimal(11, 8)
  createdAt     DateTime    @default(now()) @map("created_at")
  servicio      Servicio    @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  profesional   Profesional @relation(fields: [profesionalId], references: [id])
  @@map("tracking_historial")
}

model Tarifa {
  tipo        TipoServicio @id
  nombre      String       @db.VarChar(100)
  descripcion String?      @db.VarChar(200)
  precio      Int
  activo      Boolean      @default(true)
  updatedAt   DateTime     @updatedAt @map("updated_at")
  @@map("tarifas")
}

model RecuperacionClave {
  id        String    @id @default(uuid())
  usuarioId String    @map("usuario_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiraEn  DateTime  @map("expira_en")
  usadoEn   DateTime? @map("usado_en")
  createdAt DateTime  @default(now()) @map("created_at")
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@index([usuarioId])
  @@map("recuperaciones_clave")
}

// Un profesional se ofrece para una solicitud y el paciente escoge entre los que se ofrecieron
// estado: activa, elegida, no_elegida, retirada, vencida, desistio (lo eligieron y luego no fue)
model Oferta {
  id            String      @id @default(uuid())
  servicioId    String      @map("servicio_id")
  profesionalId String      @map("profesional_id")
  estado        String      @default("activa") @db.VarChar(20) // activa, elegida, no_elegida, retirada, vencida
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  servicio      Servicio    @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  @@unique([servicioId, profesionalId])
  @@index([profesionalId, estado])
  @@map("ofertas")
}

// Queja de un paciente sobre un servicio; la IPS la revisa desde el panel
model Queja {
  id            String       @id @default(uuid())
  servicioId    String       @map("servicio_id")
  usuarioId     String       @map("usuario_id") // cuenta del paciente que se queja
  profesionalId String?      @map("profesional_id")
  texto         String
  estado        String       @default("abierta") @db.VarChar(20) // abierta, revisada
  respuesta     String?
  revisadaEn    DateTime?    @map("revisada_en")
  createdAt     DateTime     @default(now()) @map("created_at")
  servicio      Servicio     @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  profesional   Profesional? @relation(fields: [profesionalId], references: [id], onDelete: Restrict)
  @@index([estado, createdAt])
  @@index([profesionalId])
  @@index([servicioId])
  @@map("quejas")
}

// Un paciente no quiere que un profesional lo vuelva a atender
model Bloqueo {
  id            String      @id @default(uuid())
  usuarioId     String      @map("usuario_id") // cuenta del paciente
  profesionalId String      @map("profesional_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  @@unique([usuarioId, profesionalId])
  @@index([profesionalId])
  @@map("bloqueos")
}

// Recibido del servicio: firma manuscrita del paciente o acudiente al terminar (tabla aparte para que las listas
// de servicios no carguen la imagen)
model Recibido {
  servicioId String   @id @map("servicio_id")
  firma      String?  // imagen PNG pequeña (data URL)
  nombre     String?  @db.VarChar(200)
  motivo     String?  @db.VarChar(300) // por qué no firmó, si no pudo
  createdAt  DateTime @default(now()) @map("created_at")
  servicio   Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  @@map("recibidos")
}

// Ajustes guardados por el propio servidor (por ejemplo, las claves de los avisos al celular)
model Ajuste {
  clave     String   @id @db.VarChar(80)
  valor     String
  createdAt DateTime @default(now()) @map("created_at")
  @@map("ajustes")
}

// Registro de lo que hace la IPS con las cuentas (bloqueos, enlaces de contraseña); no se borra
model Bitacora {
  id        String   @id @default(uuid())
  actorId   String   @map("actor_id")
  usuarioId String?  @map("usuario_id")
  accion    String   @db.VarChar(40)
  detalle   String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  @@index([usuarioId, createdAt])
  @@map("bitacora")
}
